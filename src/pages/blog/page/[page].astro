---
import type { CollectionEntry } from 'astro:content'
/**
 * /blog/page/[page] — pages 2+ of the paginated blog index.
 * Page 1 lives at /blog/ (see ../index.astro).
 *
 * Uses Astro's `paginate()` and skips the first page so the canonical URL
 * for it stays /blog/ (avoids /blog/page/1 duplicates).
 */
import type { GetStaticPaths, Page } from 'astro'
import PostCard from '~/components/blog/PostCard.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import PawSpeciesRail from '~/components/PawSpeciesRail.astro'
import { getPublishedPosts } from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

export const getStaticPaths = (async ({ paginate }) => {
  const pageSize = 12
  const posts = await getPublishedPosts()
  return paginate(posts, { pageSize }).filter(
    (p) => p.params.page !== '1' && p.params.page !== undefined,
  )
}) satisfies GetStaticPaths

interface PageProps {
  page: Page<CollectionEntry<'blog'>>
}
const { page } = Astro.props as PageProps

const prevHref = page.currentPage === 2 ? '/blog/' : page.url.prev
const nextHref = page.url.next

const title = `Blog — page ${page.currentPage}`
const description = `Page ${page.currentPage} of writing on software, AI agents, finance tooling, and the tools I build.`
---

<BaseLayout title={title} description={description} canonical={new URL(page.url.current, SITE_CONFIG.url).toString()}>
  <div class="container-page section">
    <header class="blog-head">
      <p class="blog-kicker mono">Field notes / continued</p>
      <h1>All Guides</h1>
      <p class="blog-lede">
        Dispatches {page.start + 1}–{page.end} of {page.total}; page {page.currentPage} of {page.lastPage}.
      </p>
    </header>

    <PawSpeciesRail />

    <ul class="post-list">
      {page.data.map((p) => (
        <li>
          <PostCard post={p} />
        </li>
      ))}
    </ul>

    <nav class="pager" aria-label="Pagination">
      {prevHref ? (
        <a class="pager-link" href={prevHref} rel="prev">← Prev</a>
      ) : (
        <span class="pager-link is-disabled" aria-hidden="true">← Prev</span>
      )}
      <span class="pager-info">Page {page.currentPage} of {page.lastPage}</span>
      {nextHref ? (
        <a class="pager-link" href={nextHref} rel="next">Next →</a>
      ) : (
        <span class="pager-link is-disabled" aria-hidden="true">Next →</span>
      )}
    </nav>
  </div>
</BaseLayout>

<style>
  .blog-head { margin-bottom: 1.5rem; padding-block: clamp(2rem, 5vw, 3rem) 1.25rem; border-bottom: 2px solid var(--ink); }
  .blog-kicker {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .blog-head h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.04;
    margin: 0;
  }
  .blog-lede { color: var(--ink-mute); margin: 0.5rem 0 0; max-width: 60ch; }
  .chip-strip, .chip { display: none; } /* replaced by PawSpeciesRail */
  .pager {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .pager-info { color: var(--ink-mute); font-family: var(--font-mono); font-size: 0.75rem; }
  .pager-link {
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: transparent;
  }
  .pager-link:hover { border-color: var(--accent); color: var(--accent); }
  .pager-link.is-disabled { color: var(--ink-mute); opacity: 0.5; }
  .section { padding-block: 3rem; }
</style>
