---
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — PawPost "kennel board": a PLAYFUL BENTO GRID dashboard.
 *
 * Not a linear list and not the top-nav card-grid the sibling blogs share.
 * A mixed-size tile board on a 4-col (desktop) grid:
 *   ┌────────────┬──────┬──────┐
 *   │  FEATURED  │ desk │ desk │   featured = 2×2 intake card (thesis)
 *   │  (2×2)     ├──────┼──────┤   desk tiles = pet-desk category chips
 *   │            │ desk │ desk │
 *   ├──────┬─────┴──────┴──────┤
 *   │ NOW  │  latest  latest   │   now-running series tile + latest guide tiles
 *   │ RUN  ├──────┬──────┬─────┤
 *   │(1×2) │ late │ late │ ALL │   ALL = archive CTA tile
 *   └──────┴──────┴──────┴─────┘
 * Rounded 14–20px, bouncy hover (lift + tiny rotate), paw signature retained.
 * Mobile: single column, tiles stack in reading order; featured first.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const recentPosts = allPosts.slice(1, 7)

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({ name: series, slug: slugifyTag(series), total, published: count, current: count, latest })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())
const nowRunning = inProgress[0]

const cats = (await getCategoriesWithCounts()).slice(0, 4)

const now = new Date()
const dateline = now.toLocaleDateString('en-GB', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
})
const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'today'
  if (days === 1) return '1d ago'
  if (days < 30) return `${days}d ago`
  const months = Math.floor(days / 30)
  if (months === 1) return '1mo ago'
  if (months < 12) return `${months}mo ago`
  const years = Math.floor(days / 365)
  return years === 1 ? '1y ago' : `${years}y ago`
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="PawPost — the pet-care board for dogs & cats"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  <div class="board">
    <p class="board-line mono">
      <span class="board-stamp">On the board</span>
      <span aria-hidden="true">·</span>
      <span>{dateline}</span>
      <span aria-hidden="true">·</span>
      <span><span class="count">{allPosts.length}</span> field notes on file</span>
    </p>

    <div class="bento">
      {/* FEATURED tile (2×2) — the thesis. */}
      <section class="tile tile-hero" data-vertical={leadVertical} aria-labelledby="hero-title">
        <span class="hero-eyebrow mono">
          <span class="hero-notch" aria-hidden="true"></span>{lead ? verticalLabel(leadVertical) : 'PawPost'} · start here
        </span>
        <h1 id="hero-title" class="hero-thesis">
          Good pet care is boring, repeatable, checkable. We write down the boring part so your dog or cat gets the good years.
        </h1>
        {lead ? (
          <a class="hero-lead" href={`/blog/${lead.id}`}>
            <span class="hero-lead-title">{lead.data.title}</span>
            <span class="hero-lead-dek">{lead.data.description}</span>
            <span class="hero-lead-foot mono">
              <time datetime={lead.data.pubDate.toISOString()}>{lead.data.pubDate.toISOString().slice(0, 10)}</time>
              <span aria-hidden="true">·</span><span>{leadRt}</span>
            </span>
          </a>
        ) : (
          <p class="hero-lead-dek">Plain-language guides on puppies, cats, nutrition, behaviour, and health.</p>
        )}
        <span class="paw-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="15" r="4.4" /><circle cx="6" cy="9" r="2.1" />
            <circle cx="18" cy="9" r="2.1" /><circle cx="9" cy="5.5" r="1.8" /><circle cx="15" cy="5.5" r="1.8" />
          </svg>
        </span>
      </section>

      {/* Pet-desk chips (mini tiles). */}
      {cats.map((c) => (
        <a class="tile tile-desk" href={`/categories/${slugifyTag(c.category)}/`} data-vertical={verticalFor(c.category)}>
          <span class="desk-dot" aria-hidden="true"></span>
          <span class="desk-name">{c.category}</span>
          <span class="desk-count mono">{c.count} {c.count === 1 ? 'guide' : 'guides'}</span>
        </a>
      ))}

      {/* NOW RUNNING series tile (tall). */}
      {nowRunning && (
        <a class="tile tile-now" href={`/series/${nowRunning.slug}/`}>
          <span class="now-label mono">Now running</span>
          <span class="now-name">{nowRunning.name}</span>
          <span class="now-spine">
            <SeriesSpine total={nowRunning.total} published={nowRunning.published} current={nowRunning.current} size="md" />
          </span>
          <span class="now-meta mono">part {nowRunning.published} of {nowRunning.total} · {ago(nowRunning.latest)}</span>
        </a>
      )}

      {/* Latest guide tiles. */}
      {recentPosts.map((p) => (
        <a class="tile tile-post" href={`/blog/${p.id}`} data-vertical={postVertical(p)}>
          <span class="post-kicker mono">
            <span class="post-notch" aria-hidden="true"></span>{verticalLabel(postVertical(p))}
          </span>
          <span class="post-title">{p.data.title}</span>
          <span class="post-foot mono">
            <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
            <span aria-hidden="true">·</span><span>{p.data.readingTime ?? readingTimeFor(p)}</span>
          </span>
        </a>
      ))}

      {/* ALL guides CTA tile. */}
      <a class="tile tile-all" href="/archive/">
        <span class="all-num">{allPosts.length}</span>
        <span class="all-label">guides in the archive</span>
        <span class="all-go mono">Open the shelf →</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .board {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(0.9rem, 3vw, 1.5rem);
    padding-block: clamp(1.25rem, 4vw, 2rem) 0;
  }
  .board-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 1.25rem;
  }
  .board-stamp {
    color: var(--color-accent-fg, #fff);
    background: var(--brand);
    padding: 0.15em 0.6em;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .board-line .count { color: var(--ink); font-weight: 700; }

  /* ── Bento grid ─────────────────────────────────────────────────────── */
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    grid-auto-flow: dense;
  }
  @media (min-width: 620px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .bento { grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  }

  .tile {
    --v: var(--v-personal);
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: 1.125rem 1.25rem;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform var(--dur-base, 200ms) cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color var(--dur-base, 200ms) ease,
      box-shadow var(--dur-base, 200ms) ease;
  }
  .tile[data-vertical='dev'] { --v: var(--v-dev); }
  .tile[data-vertical='finance'] { --v: var(--v-finance); }
  .tile[data-vertical='culture'] { --v: var(--v-culture); }
  .tile[data-vertical='health'] { --v: var(--v-health); }
  a.tile:hover {
    transform: translateY(-4px) rotate(-0.5deg);
    border-color: var(--v);
    box-shadow: 0 10px 26px color-mix(in oklab, var(--ink) 12%, transparent);
  }

  /* FEATURED (2×2) */
  .tile-hero {
    border-radius: 20px;
    border-top: 5px solid var(--v);
    background: var(--paper-2);
    box-shadow: inset 0 0 0 4px var(--paper-2), inset 0 0 0 5px color-mix(in oklab, var(--tag) 45%, transparent);
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 1.9rem);
  }
  @media (min-width: 620px) { .tile-hero { grid-column: span 2; } }
  @media (min-width: 960px) { .tile-hero { grid-column: span 2; grid-row: span 2; } }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--v); font-weight: 700;
  }
  .hero-notch { width: 9px; height: 9px; border-radius: 999px; background: var(--v); }
  .hero-thesis {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    font-weight: 600; line-height: 1.12; letter-spacing: -0.02em;
    margin: 0; max-width: 20ch;
    font-variation-settings: 'SOFT' 40, 'opsz' 60;
  }
  .hero-lead {
    margin-top: auto;
    display: grid; gap: 0.3rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--rule);
    color: var(--ink); text-decoration: none;
  }
  .hero-lead-title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em; }
  .tile-hero:hover .hero-lead-title { color: var(--brand); }
  .hero-lead-dek {
    font-family: var(--font-body); font-size: 0.95rem; line-height: 1.5; color: var(--ink-mute);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden;
  }
  .hero-lead-foot { display: inline-flex; gap: 0.4rem; font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute); }
  .paw-mark {
    position: absolute; right: -14px; bottom: -14px; width: 96px; height: 96px;
    opacity: 0.08; pointer-events: none;
  }
  .paw-mark svg { width: 100%; height: 100%; fill: var(--v); transform: rotate(-12deg); }

  /* DESK chips */
  .tile-desk { gap: 0.5rem; justify-content: center; min-height: 92px; }
  .desk-dot { width: 12px; height: 12px; border-radius: 999px; background: var(--v); box-shadow: 0 0 0 4px color-mix(in oklab, var(--v) 18%, transparent); }
  .desk-name { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em; }
  .tile-desk:hover .desk-name { color: var(--v); }
  .desk-count { font-size: 11px; letter-spacing: 0.06em; color: var(--ink-mute); }

  /* NOW RUNNING (tall) */
  .tile-now {
    gap: 0.55rem;
    background: linear-gradient(160deg, var(--brand-soft), var(--paper-2) 70%);
    border-color: color-mix(in oklab, var(--brand) 30%, var(--rule));
  }
  @media (min-width: 960px) { .tile-now { grid-row: span 2; justify-content: center; } }
  .now-label { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brand); font-weight: 700; }
  .now-name { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; line-height: 1.18; letter-spacing: -0.01em; }
  .tile-now:hover .now-name { color: var(--brand); }
  .now-spine { display: inline-flex; margin-block: 0.15rem; }
  .now-meta { font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute); }

  /* POST tiles */
  .tile-post { border-top: 4px solid var(--v); gap: 0.5rem; min-height: 128px; }
  .post-kicker { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--v); font-weight: 700; }
  .post-notch { width: 7px; height: 7px; border-radius: 999px; background: var(--v); }
  .post-title {
    font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; line-height: 1.22; letter-spacing: -0.01em;
    font-variation-settings: 'SOFT' 40, 'opsz' 30;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  }
  .tile-post:hover .post-title { color: var(--brand); }
  .post-foot { margin-top: auto; display: inline-flex; gap: 0.4rem; font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute); }

  /* ALL CTA */
  .tile-all {
    background: var(--brand); color: var(--color-accent-fg, #fff);
    border-color: var(--brand);
    gap: 0.15rem; justify-content: center; min-height: 128px;
    box-shadow: inset 0 0 0 4px var(--brand), inset 0 0 0 5px color-mix(in oklab, var(--tag) 55%, transparent);
  }
  .tile-all:hover { border-color: var(--tag); }
  .all-num { font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, 3.2rem); font-weight: 600; line-height: 1; }
  .all-label { font-family: var(--font-body); font-size: 0.95rem; opacity: 0.92; }
  .all-go { margin-top: 0.5rem; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; opacity: 0.95; }

  @media (prefers-reduced-motion: reduce) {
    .tile { transition: border-color var(--dur-base, 200ms) ease; }
    a.tile:hover { transform: none; }
  }
</style>
