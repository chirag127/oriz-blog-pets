---
/*
 * PawPost Footer — "Kennel Card" surface.
 *
 * Signature element: a Fraunces pull-quote with a teal enamel quote mark and a
 * small paw-print — the footer's one raised voice. Everything else stays
 * library-quiet: engraved-mono column headings, mono tag links, kraft hairlines.
 *
 * Reads palette + type from the Kennel Card tokens (tokens.css / global.css).
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import {
  getCategoriesWithCounts,
  getTagsWithCounts,
  slugifyTag,
} from '~/lib/blog'

const categories = [
  { name: 'All topics', slug: '' },
  ...(await getCategoriesWithCounts()).slice(0, 6).map(({ category }) => ({
    name: category,
    slug: slugifyTag(category),
  })),
]
const tags = (await getTagsWithCounts()).slice(0, 8).map(({ tag }) => tag)
---
<footer class="blog-footer" role="contentinfo">
  <div class="bf-quote">
    <blockquote>
      <span aria-hidden="true" class="bf-q-mark">“</span>
      Every pet deserves an owner who read the manual first.
    </blockquote>
    <p class="bf-quote-attr">— PawPost · pet care, checked</p>
  </div>
  <div class="bf-grid">
    <div class="bf-col">
      <h3 class="bf-h">Topics</h3>
      <ul>
        {categories.map((c) => <li><a href={c.slug ? `/categories/${c.slug}/` : '/categories/'}>{c.name}</a></li>)}
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h">Shelf</h3>
      <ul>
        <li><a href="/blog/">Newest guides</a></li>
        <li><a href="/archive/">Full archive</a></li>
        <li><a href="/now/">Now page</a></li>
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h">Tags</h3>
      <ul class="bf-tags">
        {tags.map((t) => <li><a href={`/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h">Series</h3>
      <ul>
        <li><a href="/series/">Multi-part guides</a></li>
        <li><a href="/categories/">All topics</a></li>
      </ul>
    </div>
  </div>
  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-pets"
    appName="PawPost"
    bio="Practical, science-checked pet care for dogs and cats by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .blog-footer {
    margin-top: 5rem;
    background: var(--color-paper-2, var(--paper-2, transparent));
    color: var(--color-ink, var(--ink));
    border-top: 1px solid var(--color-rule, var(--rule));
  }
  .bf-quote {
    max-width: 1200px; margin: 0 auto;
    padding: 48px 16px 24px;
    text-align: left;
  }
  .bf-quote blockquote {
    margin: 0;
    font-family: var(--font-display, 'Source Serif 4', Georgia, serif);
    font-style: normal; font-weight: 600; font-size: clamp(22px, 3.2vw, 30px);
    line-height: 1.3; letter-spacing: -0.015em;
    color: var(--color-ink, var(--ink)); max-width: 560px;
  }
  .bf-q-mark { font-size: 1.5em; line-height: 0; color: var(--color-accent, var(--brand, #2f8f7e)); margin-right: 4px; }
  .bf-quote-attr {
    margin: 16px 0 0; font-family: var(--font-mono, ui-monospace);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--color-ink-mute, var(--ink-mute));
  }
  .bf-grid {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 24px;
    padding: 12px 16px 24px;
  }
  .bf-h {
    margin: 0 0 14px;
    font-family: var(--font-mono, ui-monospace);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--color-ink-mute, var(--ink-mute)); font-weight: 500;
  }
  .bf-col {
    background: var(--color-paper, var(--paper));
    border: 1px solid var(--color-rule, var(--rule));
    border-radius: var(--radius-card, 14px);
    padding: 16px 18px;
  }
  .bf-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .bf-col a { color: var(--color-ink, var(--ink)); font-size: 14px; text-decoration: none; }
  .bf-col a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .bf-tags { flex-direction: row; flex-wrap: wrap; gap: 8px 12px; }
  .bf-tags a { font-family: var(--font-mono, ui-monospace); font-size: 13px; color: var(--color-ink-mute, var(--ink-mute)); }
  .bf-tags a:hover { color: var(--color-accent, var(--brand, #2f8f7e)); text-decoration: none; }
  @media (min-width: 768px) { .bf-grid { grid-template-columns: 1fr 1fr; gap: 32px; padding: 16px 24px 28px; } .bf-quote { padding: 64px 24px 20px; } }
  @media (min-width: 1024px) { .bf-grid { grid-template-columns: repeat(4, 1fr); padding: 16px 24px 32px; } }
</style>
