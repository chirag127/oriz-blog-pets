---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — compact "collar bar" for the PawPost bento dashboard.
 *
 * NOT the top-double-header + LATEST/SERIES/TAGS/ABOUT rule the sibling blogs
 * share. Single slim (52px) sticky bar: enamel collar-tag wordmark left, nav as
 * a rounded bouncy pill cluster (each item is its own tag), search + controls
 * right. The pills bob on hover — the playful cue that carries the bento layout.
 */
import Wordmark from '~/components/Wordmark.astro'

const path = Astro.url.pathname
const isHome = path === '/'
const nav = [
  { href: '/', label: 'Board', on: isHome },
  { href: '/series/', label: 'Series', on: path.startsWith('/series') },
  { href: '/tags/', label: 'Tags', on: path.startsWith('/tags') },
  { href: '/about/', label: 'About', on: path.startsWith('/about') },
]
---

<StatusBanner />
<header class="collar-bar" transition:persist="site-header">
  <div class="cb-inner">
    <a class="cb-brand" href="/" aria-label="PawPost home">
      <Wordmark subtitle="care" size={19} />
    </a>
    <nav class="cb-nav" aria-label="Primary">
      {nav.map((n) => (
        <a class="cb-pill" href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="cb-tail">
      <div class="cb-search"><MultiSearch client:idle /></div>
      <HeaderControls client:idle />
    </div>
  </div>
</header>

<style>
  .collar-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .cb-inner {
    max-width: 1200px;
    margin-inline: auto;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-inline: clamp(0.9rem, 3vw, 1.5rem);
  }
  .cb-brand { flex: 0 0 auto; display: inline-flex; align-items: center; text-decoration: none; }

  /* nav = a cluster of rounded collar tags that bob on hover */
  .cb-nav {
    display: none;
    align-items: center;
    gap: 0.375rem;
    margin-left: 0.5rem;
  }
  .cb-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.8rem;
    font-family: var(--font-utility, var(--font-mono));
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    text-decoration: none;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 999px;
    transition:
      transform var(--dur-base, 200ms) var(--ease-out, cubic-bezier(0.34, 1.56, 0.64, 1)),
      background var(--dur-fast, 120ms) ease,
      color var(--dur-fast, 120ms) ease,
      border-color var(--dur-fast, 120ms) ease;
  }
  .cb-pill:hover {
    color: var(--brand);
    background: var(--brand-soft);
    transform: translateY(-2px) rotate(-2deg);
  }
  .cb-pill[aria-current='page'] {
    color: var(--color-accent-fg, #fff);
    background: var(--brand);
    border-color: var(--brand);
    box-shadow: inset 0 0 0 2px color-mix(in oklab, var(--tag) 60%, transparent);
  }
  @media (min-width: 768px) {
    .cb-nav { display: inline-flex; }
  }

  .cb-tail {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .cb-search { display: inline-flex; align-items: center; }

  @media (prefers-reduced-motion: reduce) {
    .cb-pill { transition: background var(--dur-fast, 120ms) ease, color var(--dur-fast, 120ms) ease; }
    .cb-pill:hover { transform: none; }
  }
</style>
