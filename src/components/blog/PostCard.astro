---
/**
 * PostCard — PawPost "intake card" entry.
 *
 * A rounded collar-tag card (radius 14px) with:
 *   - colour-coded top border per vertical (vet-desk teal / marmalade / etc.)
 *   - species/topic emoji chip
 *   - Fraunces display headline
 *   - one-line dek
 *   - mono meta foot (date · reading time)
 *   - bouncy lift hover (matches the bento grid energy)
 *
 * Deliberately NOT the flat hairline row used by sibling blogs.
 */
import type { CollectionEntry } from 'astro:content'
import { formatPostDate, postVertical, slugifyTag, verticalLabel } from '~/lib/blog'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const catHref = `/categories/${slugifyTag(category)}/`
const vert = postVertical(post)

// species emoji mapping
const catIcon: Record<string, string> = {
  dogs: '🐕', cats: '🐈', birds: '🐦', fish: '🐟', rabbits: '🐇',
  reptiles: '🦎', 'small pets': '🐹', puppies: '🐶', kittens: '😺',
  nutrition: '🥩', health: '💊', behaviour: '🧠', training: '🎾',
  grooming: '✂️', default: '🐾',
}
function iconFor(name: string): string {
  const key = name.toLowerCase()
  for (const [k, v] of Object.entries(catIcon)) {
    if (key.includes(k)) return v
  }
  return catIcon.default
}
const icon = iconFor(category)
---

<article class="post-card" data-vertical={vert}>
  <a class="post-card-link" href={href}>
    <span class="post-card-kicker">
      <span class="post-card-icon" aria-hidden="true">{icon}</span>
      <span class="post-card-desk">{verticalLabel(vert)}</span>
      <span class="post-card-cat">{category}</span>
    </span>
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-desc">{description}</p>
    <span class="post-card-foot">
      <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
      {readingTime && <span class="post-card-rt">{readingTime}</span>}
    </span>
  </a>
  <a class="post-card-cat-link" href={catHref} aria-label={`More in ${category}`}>{category}</a>
</article>

<style>
  .post-card {
    position: relative;
    --v: var(--v-personal);
    margin-bottom: 0.75rem;
  }
  .post-card[data-vertical='dev'] { --v: var(--v-dev); }
  .post-card[data-vertical='finance'] { --v: var(--v-finance); }
  .post-card[data-vertical='culture'] { --v: var(--v-culture); }
  .post-card[data-vertical='health'] { --v: var(--v-health); }

  .post-card-link {
    display: grid;
    gap: 0.45rem;
    padding: 1.125rem 1.25rem 1.125rem 1.125rem;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--v);
    border-radius: var(--radius-card, 14px);
    transition:
      transform var(--dur-base, 200ms) cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color var(--dur-base, 200ms) ease,
      box-shadow var(--dur-base, 200ms) ease;
  }
  .post-card-link:hover {
    transform: translateY(-3px) rotate(-0.4deg);
    border-color: var(--v);
    box-shadow: 0 8px 20px color-mix(in oklab, var(--ink) 10%, transparent);
  }

  .post-card-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .post-card-icon { font-size: 14px; line-height: 1; }
  .post-card-desk { color: var(--v); font-weight: 500; }
  .post-card-cat {
    color: var(--ink-mute);
    border-left: 1px solid var(--rule);
    padding-left: 0.4rem;
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
    color: var(--ink);
    font-variation-settings: 'SOFT' 40, 'opsz' 30;
  }
  .post-card-link:hover .post-card-title { color: var(--v); }

  .post-card-desc {
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
    max-width: 62ch;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
  }
  .post-card-foot {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    margin-top: 0.125rem;
  }
  .post-card-rt::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--rule-strong, var(--rule));
  }
  /* Sibling deep-link to category — visually hidden, keyboard reachable. */
  .post-card-cat-link {
    position: absolute;
    inset: 0 0 auto auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .post-card-cat-link:focus-visible {
    width: auto;
    height: auto;
    clip: auto;
    top: 1.125rem;
    right: 0.75rem;
    padding: 0.125rem 0.5rem;
    background: var(--paper);
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card-link {
      transition: border-color var(--dur-fast, 120ms) ease;
    }
    .post-card-link:hover { transform: none; box-shadow: none; }
  }
</style>
